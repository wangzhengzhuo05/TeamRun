TEAMRUN_DOMAIN=teamrun.example.com
TEAMRUN_DATABASE_PASSWORD=replace-with-a-random-database-password
TEAMRUN_SHARED_KEY=replace-with-at-least-24-random-characters
TEAMRUN_SHARED_KEY_EMAIL=team@teamrun.local
TEAMRUN_SHARED_KEY_DISPLAY_NAME="TeamRun Team"
# Generate with: openssl rand -base64 32
TEAMRUN_RUNTIME_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
TEAMRUN_S3_ACCESS_KEY_ID=teamrun
TEAMRUN_S3_SECRET_ACCESS_KEY=replace-with-a-random-object-storage-password
