{
  "name": "@teamrun/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1114.0",
    "@aws-sdk/s3-request-presigner": "3.1114.0",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@teamrun/contracts": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "jose": "6.2.9",
    "postgres": "3.4.9",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.5"
  }
}
